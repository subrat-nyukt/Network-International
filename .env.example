# ==============================================================================
# AI Insights Engine API Configuration (Copy to .env for local use)
# Never commit your actual .env file or API keys to Git!
# On Streamlit Community Cloud, paste keys in App Settings -> Secrets.
# Note: If no key is provided, the app automatically falls back to its built-in
# Deterministic Grounded Analytics Engine so the dashboard works 100% offline.
# ==============================================================================

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
